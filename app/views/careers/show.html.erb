<div class="page-header" style="margin-top: 0;">
  <div class="pull-right">
    <%= link_to careers_path, class: 'btn btn-default' do %>
      <i class="fa fa-arrow-left"></i> Volver a Programas
    <% end %>
  </div>
  <h2><%= @career.name %> <small>(Codigo <%= @career.code %>)</small></h2>
  <p class="text-muted"><%= @faculty.name %> - <%= @career.degree_level %> - Exigencia: <%= @career.total_credits %> creditos academicos</p>
</div>

<div class="row" style="margin-bottom: 20px;">
  <div class="col-md-3">
    <div class="metric-card">
      <h3><%= @career.total_credits %></h3>
      <p>Creditos del Plan</p>
    </div>
  </div>
  <div class="col-md-3">
    <div class="metric-card" style="border-left-color: #80A535;">
      <h3><%= @career.duration_semesters %></h3>
      <p>Semestres</p>
    </div>
  </div>
  <div class="col-md-3">
    <div class="metric-card" style="border-left-color: #0284C7;">
      <h3><%= @career.subjects.count %></h3>
      <p>Asignaturas</p>
    </div>
  </div>
  <div class="col-md-3">
    <div class="metric-card" style="border-left-color: #10B981;">
      <h3><%= @career.average_papa %></h3>
      <p>PAPA Promedio Cohorte</p>
    </div>
  </div>
</div>

<div class="panel panel-default panel-unal">
  <div class="panel-heading">
    <i class="fa fa-sitemap"></i> Malla Curricular por Niveles Semestrales
  </div>
  <div class="panel-body">
    <% if @subjects_by_level.empty? %>
      <p class="text-muted">No hay asignaturas asociadas a este programa curricular.</p>
    <% else %>
      <% @subjects_by_level.keys.sort.each do |level| %>
        <h4 style="border-bottom: 2px solid #E2E8F0; padding-bottom: 6px; margin-top: 20px;">
          <span class="label label-unal-primary" style="background:#005944">Semestre <%= level %></span>
        </h4>
        <div class="row">
          <% @subjects_by_level[level].each do |sub| %>
            <div class="col-md-4 col-sm-6">
              <div style="border: 1px solid #E2E8F0; border-radius: 6px; padding: 12px; margin-bottom: 12px; background: #FFF;">
                <div class="pull-right">
                  <span class="label <%= sub.typology_badge_class %>"><%= sub.typology %></span>
                  <span class="badge"><%= sub.credits %> cred</span>
                </div>
                <strong><%= link_to sub.name, subject_path(sub) %></strong>
                <br>
                <small class="text-muted">Cod: <%= sub.code %> | <%= sub.typology_name %></small>
                <% if sub.prerequisites.any? %>
                  <div style="margin-top: 6px; font-size: 11px; color: #DC2626;">
                    <i class="fa fa-lock"></i> Prerreq: <%= sub.prerequisites.map(&:name).join(', ') %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
