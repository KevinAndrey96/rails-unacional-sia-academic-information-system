<div class="page-header" style="margin-top: 0;">
  <div class="pull-right">
    <%= link_to transcript_student_path(@student), class: 'btn btn-unal-primary' do %>
      <i class="fa fa-print"></i> Ver Historia Academica Oficial
    <% end %>
    <%= link_to students_path, class: 'btn btn-default' do %>
      <i class="fa fa-arrow-left"></i> Volver
    <% end %>
  </div>
  <h2><%= @student.full_name %> <small>(Carnet: <%= @student.student_code %>)</small></h2>
  <p class="text-muted"><%= @student.email %> - <%= @career.name %> (<%= @faculty.name %>)</p>
</div>

<div class="row" style="margin-bottom: 20px;">
  <div class="col-md-3">
    <div class="metric-card">
      <h3><%= @student.papa %></h3>
      <p>PAPA Acumulado</p>
    </div>
  </div>
  <div class="col-md-3">
    <div class="metric-card" style="border-left-color: #80A535;">
      <h3><%= @student.percentage_advance %>%</h3>
      <p>Porcentaje Avance (PA)</p>
    </div>
  </div>
  <div class="col-md-3">
    <div class="metric-card" style="border-left-color: #0284C7;">
      <h3><%= @student.approved_credits %> / <%= @career.total_credits %></h3>
      <p>Creditos Aprobados</p>
    </div>
  </div>
  <div class="col-md-3">
    <div class="metric-card" style="border-left-color: #F59E0B;">
      <h3><%= @quota[:quota] %> cred.</h3>
      <p>Cupo Semestral (CSU 008)</p>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-8">
    <div class="panel panel-default panel-unal">
      <div class="panel-heading">
        <div class="pull-right">
          <%= link_to new_enrollment_path(student_id: @student.id), class: 'btn btn-xs btn-unal-success' do %>
            <i class="fa fa-plus"></i> Inscribir Asignatura
          <% end %>
        </div>
        <i class="fa fa-book"></i> Registro de Asignaturas Cursadas
      </div>
      <div class="panel-body" style="padding: 0;">
        <table class="table table-hover table-striped" style="margin-bottom: 0;">
          <thead>
            <tr>
              <th>Periodo</th>
              <th>Codigo</th>
              <th>Asignatura</th>
              <th>Cred.</th>
              <th>Tipologia</th>
              <th>Nota</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody>
            <% @enrollments.each do |enr| %>
              <% sub = enr.course_group.subject %>
              <tr>
                <td><code><%= enr.academic_period.code %></code></td>
                <td><%= sub.code %></td>
                <td><strong><%= sub.name %></strong></td>
                <td><%= sub.credits %></td>
                <td><span class="label <%= sub.typology_badge_class %>"><%= sub.typology %></span></td>
                <td>
                  <% if enr.final_grade.present? %>
                    <strong style="color: <%= enr.final_grade >= 3.0 ? '#10B981' : '#EF4444' %>;">
                      <%= enr.final_grade %>
                    </strong>
                  <% else %>
                    <span class="text-muted">En Curso</span>
                  <% end %>
                </td>
                <td>
                  <span class="label label-<%= enr.status == 'Aprobada' ? 'success' : (enr.status == 'Reprobada' ? 'danger' : 'info') %>">
                    <%= enr.status %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="panel panel-default panel-unal">
      <div class="panel-heading">
        <i class="fa fa-shield"></i> Informacion Academica
      </div>
      <div class="panel-body">
        <p><strong>Documento:</strong> <%= @student.document %></p>
        <p><strong>Periodo de Ingreso:</strong> <%= @student.entry_period %></p>
        <p><strong>Condicion Academica:</strong> <span class="label label-<%= @standing[:badge] %>"><%= @standing[:status] %></span></p>
        <p><strong>Regla de Cupo:</strong> <%= @quota[:label] %></p>
        <hr>
        <p class="text-muted" style="font-size: 12px;">
          <i class="fa fa-info-circle"></i> Segun el Acuerdo 008 de 2008 CSU, la nota minima aprobatoria en pregrado de la Universidad Nacional es de 3.0 sobre 5.0.
        </p>
      </div>
    </div>
  </div>
</div>
